end":136.44},{"id":"cap-95","start":136.44,"end":138.6},{"id":"cap-96","start":138.6,"end":139.18},{"id":"cap-97","start":139.22,"end":140.3},{"id":"cap-98","start":140.34,"end":141.46},{"id":"cap-99","start":141.5,"end":142.9},{"id":"cap-100","start":142.9,"end":145.11},{"id":"cap-101","start":145.11,"end":146.16},{"id":"cap-102","start":146.3,"end":147.79},{"id":"cap-103","start":147.93,"end":148.87},{"id":"cap-104","start":148.87,"end":149.92},{"id":"cap-105","start":149.92,"end":151.86},{"id":"cap-106","start":151.86,"end":152.58},{"id":"cap-107","start":152.62,"end":153.77},{"id":"cap-108","start":153.77,"end":155.16},{"id":"cap-109","start":155.54,"end":156.86},{"id":"cap-110","start":156.9,"end":158.31},{"id":"cap-111","start":158.31,"end":159.91},{"id":"cap-112","start":159.91,"end":161.63},{"id":"cap-113","start":161.63,"end":163.5},{"id":"cap-114","start":163.54,"end":164.75},{"id":"cap-115","start":164.75,"end":166.5},{"id":"cap-116","start":166.54,"end":167.78},{"id":"cap-117","start":167.78,"end":169.09},{"id":"cap-118","start":169.52,"end":169.62},{"id":"cap-119","start":169.66,"end":171.1},{"id":"cap-120","start":171.1,"end":171.9},{"id":"cap-121","start":171.9,"end":172.78},{"id":"cap-122","start":172.82,"end":173.62},{"id":"cap-123","start":173.66,"end":175.54},{"id":"cap-124","start":175.58,"end":178.63},{"id":"cap-125","start":178.7,"end":180.02},{"id":"cap-126","start":180.02,"end":181.18},{"id":"cap-127","start":181.18,"end":181.94},{"id":"cap-128","start":181.98,"end":183.62},{"id":"cap-129","start":183.66,"end":185.98},{"id":"cap-130","start":186.08,"end":187.33},{"id":"cap-131","start":187.48,"end":188.9},{"id":"cap-132","start":188.9,"end":191.08},{"id":"cap-133","start":191.08,"end":193.77},{"id":"cap-134","start":193.77,"end":195.27},{"id":"cap-135","start":195.58,"end":197.33},{"id":"cap-136","start":197.42,"end":199.22},{"id":"cap-137","start":199.26,"end":200.68},{"id":"cap-138","start":200.68,"end":202.55},{"id":"cap-139","start":202.55,"end":204.1},{"id":"cap-140","start":204.1,"end":204.87},{"id":"cap-141","start":204.98,"end":206.42},{"id":"cap-142","start":206.42,"end":207.78},{"id":"cap-143","start":207.78,"end":208.54},{"id":"cap-144","start":208.58,"end":211.13},{"id":"cap-145","start":211.56,"end":212.87},{"id":"cap-146","start":212.87,"end":214.14},{"id":"cap-147","start":214.18,"end":215.67},{"id":"cap-148","start":215.81,"end":216.88},{"id":"cap-149","start":216.88,"end":219.09},{"id":"cap-150","start":219.09,"end":220.74},{"id":"cap-151","start":220.78,"end":222.1},{"id":"cap-152","start":222.1,"end":223.46},{"id":"cap-153","start":223.46,"end":224.46},{"id":"cap-154","start":224.5,"end":225.91},{"id":"cap-155","start":225.91,"end":228.1},{"id":"cap-156","start":228.14,"end":229.63},{"id":"cap-157","start":229.7,"end":231.76},{"id":"cap-158","start":231.8,"end":233.29},{"id":"cap-159","start":233.43,"end":234.58},{"id":"cap-160","start":234.62,"end":236.12},{"id":"cap-161","start":236.16,"end":237.07},{"id":"cap-162","start":237.16,"end":238.08}];

      // Per skill: every group MUST have a hard kill after exit
      const FADE_IN = 0.18;
      const FADE_OUT = 0.14;

      groups.forEach(g => {
        const sel = "#" + g.id;
        // entrance — set visible just before fade-in
        tl.set(sel, { visibility: "visible" }, g.start);
        tl.fromTo(sel,
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: FADE_IN, ease: "power2.out" },
          g.start
        );
        // exit
        tl.to(sel, {
          opacity: 0, duration: FADE_OUT, ease: "power2.in"
        }, g.end - FADE_OUT);
        // HARD KILL — non-negotiable per skill features.md
        tl.set(sel, { opacity: 0, visibility: "hidden" }, g.end);
      });

      window.__timelines["captions"] = tl;
    </script>
  </div>
</template>
